#!/bin/sh
# Blocca i push diretti su main: le modifiche passano da una pull request.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push diretto su main bloccato: lavora su un branch e apri una pull request." >&2
    exit 1
  fi
done
exit 0
